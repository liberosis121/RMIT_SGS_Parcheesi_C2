# Copy to .env (git-ignored) and fill in. Never commit .env.

# TideCloak bootstrap admin (local dev container only). Choose a strong value.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Tide licence: a real email YOU control, and "yes" only if YOU read and accept https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

TIDECLOAK_URL=http://localhost:8080
REALM=khien-nha
